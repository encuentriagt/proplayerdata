# ppd API — variables de entorno (SIN valores secretos aquí).
# En el servidor el .env real lo crea un script; nunca se sube a GitHub.

APP_NAME=ppd
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ppdguate.com
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Base de datos (MariaDB, tablas InnoDB)
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Drivers intercambiables (en VPS: redis / s3 / reverb) — docs/ARQUITECTURA.md sección 15
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=null

# Seguridad
CORS_ALLOWED_ORIGINS=https://ppdguate.com,https://pc.ppdguate.com,https://admin.ppdguate.com
SANCTUM_EXPIRATION_MINUTES=43200
PPD_IDEMPOTENCY_TTL_HOURS=24

# Correo (se configura en la etapa de correos)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ppdguate.com"
MAIL_FROM_NAME="ppd"
